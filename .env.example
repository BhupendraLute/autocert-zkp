# ==============================================================================
# AutoCert-ZKP: Environment Configuration Template
# Avishkar 2026-27 (RTMNU) Engineering & Technology Category
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Public Ledger & Merkle Registry)
# ------------------------------------------------------------------------------
# Publicly accessible endpoint and anon key for verifying Merkle roots and revocations.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only service role key (Required for anchoring new Merkle roots or recording revocations).
# NEVER expose this key with NEXT_PUBLIC_ or send to browser clients.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Allow in-memory mock ledger fallback in production environments (defaults to false)
# ALLOW_MOCK_LEDGER=false

# ------------------------------------------------------------------------------
# 2. OpenCode Zen AI API (Vercel AI SDK - Ingestion Layer)
# ------------------------------------------------------------------------------
# Endpoint for opencode/big-pickle structured transcript extraction
OPENCODE_ZEN_BASE_URL=https://api.opencodezen.com/v1
OPENCODE_ZEN_API_KEY=your-opencode-zen-key

# ------------------------------------------------------------------------------
# 3. Institutional Authority Overrides (Optional)
# ------------------------------------------------------------------------------
# Defaults automatically to RTMNU, SPPU, and MU accredited institutional registries.
# Set these if deploying a custom university authority instance:
# ISSUER_CODE=RTMNU
# ISSUER_NAME=Rashtrasant Tukadoji Maharaj Nagpur University
# ISSUER_DID=did:key:rtmnu_authority_8f43a9b2c1e7d6
# ISSUER_PUBLIC_KEY=ed25519_rtmnu_authority_pk_8f43a9b2c1e7d6
