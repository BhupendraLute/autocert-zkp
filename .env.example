# Supabase (Public Ledger & Merkle Registry)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (Private signing and admin root anchoring)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenCode Zen AI API (opencode/big-pickle via Vercel AI SDK)
OPENCODE_ZEN_BASE_URL=https://api.opencodezen.com/v1
OPENCODE_ZEN_API_KEY=your-opencode-zen-key
